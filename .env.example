DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
AUTH_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First administrator bootstrap (generate hash; never store a plain password)
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD_HASH=

# S3-compatible storage (MinIO locally, R2/S3 in production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=cooperative-media
STORAGE_PUBLIC_URL=
